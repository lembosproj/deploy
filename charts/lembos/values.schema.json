{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Lembos values",
  "description": "The platform section is the platform's own contract, copied from lembosproj/platform's contracts/platform-values.schema.json by scripts/sync-platform-schema.sh and compared by the chart workflow. Everything else is validated by the templates.",
  "type": "object",
  "properties": {
    "platform": {
      "title": "Lembos platform values",
      "description": "The platform contract: every setting that spans more than one component, as PlatformConfig in lembosproj/platform declares it. Generated — see scripts/export-platform-schema.sh. Unknown keys are refused because the services bind strictly, and a misspelled key would otherwise leave a setting on its default with nothing saying so.",
      "type": "object",
      "properties": {
        "userManagement": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "SelfManaged",
                "DirectorySourced"
              ]
            },
            "bootstrapAdmin": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "directory": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "syncInterval": {
              "$comment": "Represents a System.TimeSpan value.",
              "type": "string",
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
            },
            "deprovisioning": {
              "type": "object",
              "properties": {
                "minimumRosterForRatio": {
                  "type": "integer"
                },
                "maxRatio": {
                  "type": "number"
                },
                "maxAbsolute": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "roleBindings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "integrations": {
          "type": "object",
          "properties": {
            "gitHub": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "workflowTriggers": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pollInterval": {
              "$comment": "Represents a System.TimeSpan value.",
              "type": "string",
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
            },
            "batchSize": {
              "type": "integer"
            },
            "leaseDuration": {
              "$comment": "Represents a System.TimeSpan value.",
              "type": "string",
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
            },
            "initialRetryDelay": {
              "$comment": "Represents a System.TimeSpan value.",
              "type": "string",
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
            },
            "maximumRetryDelay": {
              "$comment": "Represents a System.TimeSpan value.",
              "type": "string",
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "forwardedHeaders": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knownNetworks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              }
            },
            "knownProxies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "trustAnySource": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "timeSpan": {
      "description": "A .NET TimeSpan as configuration writes it: [d.]hh:mm:ss[.fraction].",
      "type": "string",
      "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?$"
    }
  }
}
