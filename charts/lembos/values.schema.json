{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Lembos values",
  "description": "The platform section mirrors PlatformConfig (src/Lembos.AppHost/Platform/PlatformConfig.cs in lembosproj/platform) key for key, and refuses a key the platform does not know: the services bind strictly, so a misspelled setting would otherwise leave the platform on its default with nothing saying so. Everything else is validated by the templates.",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userManagement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["SelfManaged", "DirectorySourced"] },
            "bootstrapAdmin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "email": { "type": "string", "minLength": 3 }
              }
            }
          }
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "syncInterval": { "$ref": "#/definitions/timeSpan" },
            "roleBindings": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["Contributor", "Maintainer", "Administrator"] }
            },
            "deprovisioning": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minimumRosterForRatio": { "type": "integer", "minimum": 0 },
                "maxRatio": { "type": "number", "minimum": 0, "maximum": 1 },
                "maxAbsolute": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gitHub": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "workflowTriggers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "pollInterval": { "$ref": "#/definitions/timeSpan" },
            "batchSize": { "type": "integer", "minimum": 1 },
            "leaseDuration": { "$ref": "#/definitions/timeSpan" },
            "initialRetryDelay": { "$ref": "#/definitions/timeSpan" },
            "maximumRetryDelay": { "$ref": "#/definitions/timeSpan" }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "clusterDomain": { "type": "string", "minLength": 1 },
        "forwardedHeaders": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knownNetworks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$" } },
            "knownProxies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "trustAnySource": { "type": "boolean" }
          }
        }
      }
    }
  },
  "definitions": {
    "timeSpan": {
      "description": "A .NET TimeSpan as configuration writes it: [d.]hh:mm:ss[.fraction].",
      "type": "string",
      "pattern": "^([0-9]+\\.)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?$"
    }
  }
}
