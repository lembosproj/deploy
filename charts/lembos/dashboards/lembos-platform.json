      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Triggers started and failed",
      "description": "Starts Temporal accepted, and starts that failed and will be retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (workflow_type) (rate(lembos_workflow_triggers_started_total[$__rate_interval]))",
          "legendFormat": "started {{workflow_type}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (workflow_type) (rate(lembos_workflow_triggers_failed_total[$__rate_interval]))",
          "legendFormat": "failed {{workflow_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
