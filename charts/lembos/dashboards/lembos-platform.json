        "w": 6,
        "x": 12,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Temporal backlog by task queue",
      "description": "Tasks waiting for a worker. A growing backlog means too few Workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (taskqueue) (approximate_backlog{job=\"temporal\", taskqueue!~\"temporal_sys.*\"})",
          "legendFormat": "{{taskqueue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
